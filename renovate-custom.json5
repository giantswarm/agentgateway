// Repo-specific Renovate rules. Added as the last `extends` entry of the
// generated renovate.json5 and never touched by devctl align-files.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  customManagers: [
    {
      // Both image tags are pinned in values.yaml from a marker comment: they
      // name a release of the Giant Swarm line of agentgateway
      // (github.com/giantswarm/agentgateway-upstream, X.Y.Z under
      // gsoci.azurecr.io/giantswarm/agentgateway-upstream/), and the upstream
      // template's fallbacks would name upstream's own build
      // (controller: .Chart.AppVersion) or nothing at all (proxy: with no tag
      // the AGW_PROXY_IMAGE_TAG env var is not set).
      //
      // Both files are listed on purpose. sync/patches/values/values.yaml is
      // the source of truth and helm/agentgateway/values.yaml is the copy that
      // sync/sync.sh writes, so a bump has to land in both or the next sync
      // reverts it (and `make verify-sync` fails the PR).
      customType: 'regex',
      managerFilePatterns: [
        'sync/patches/values/values.yaml',
        'helm/agentgateway/values.yaml',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) registryUrl=(?<registryUrl>\\S+)\\s+tag:\\s*(?<currentValue>\\S+)',
      ],
    },
  ],
  packageRules: [
    {
      // The standalone agentgateway product is on the v1.x line: the charts
      // (cr.agentgateway.dev/charts/agentgateway and .../agentgateway-crds)
      // track github.com/agentgateway/agentgateway releases. The v2.x tags in
      // cr.agentgateway.dev are the deprecated kgateway-based control plane, a
      // different product. Renovate sees 2.2.1 > 1.4.1 and would bump across
      // products, so cap at < 2.0.0.
      // Matched by regex, anchored on the trailing path segment. Renovate names
      // an image from a custom manager with its registry included, so a bare
      // `giantswarm/...` entry silently matches nothing and the cap does not
      // apply -- which is how PR #34 proposed v1.4.1 -> v2.2.1. The gsoci
      // images are excluded: the line's data-plane image also ends in
      // /agentgateway, and its versions are the line's own (the last rule).
      matchPackageNames: [
        '/(^|[/])agentgateway$/',
        '/(^|[/])agentgateway-crds$/',
        '!/^gsoci[.]azurecr[.]io[/]/',
      ],
      allowedVersions: '< 2.0.0',
    },
    {
      // One Renovate branch per upstream release of the charts. `make
      // verify-sync` requires the CRD chart to track the controller chart, so
      // a bump of only one of the two can never go green (#37 had to fold #38
      // and #41 in by hand). The branch keeps the renovate/vendir/ prefix
      // because the sync-from-upstream workflow triggers on it, re-applies the
      // Giant Swarm delta and opens the reviewable PR from `main#update-chart`;
      // Renovate's own PR waits for Dependency Dashboard approval so the bump
      // is not proposed twice. The gsoci images are not part of this group:
      // they follow the agentgateway line's releases (next rule), whose first
      // release for a new upstream version exists only after that version was
      // vendored here.
      matchPackageNames: [
        '/(^|[/])agentgateway$/',
        '/(^|[/])agentgateway-crds$/',
        '!/^gsoci[.]azurecr[.]io[/]/',
      ],
      groupName: 'agentgateway',
      branchPrefix: 'renovate/vendir/',
      prCreation: 'approval',
    },
    {
      // The controller and proxy images are releases of the Giant Swarm line of
      // agentgateway, published from its CircleCI pipeline under the line's own
      // nested gsoci path with the line's own stable semver, decoupled from
      // upstream's versions (which upstream pin a release carries is documented
      // in the line's FORK.md). The first decoupled release is 2.0.0;
      // allowedVersions keeps Renovate on that major, because a new major of
      // the line is a change consumers follow by hand. `make verify-sync` holds
      // both tags to one stable release.
      matchDatasources: ['docker'],
      matchPackageNames: [
        '/^gsoci[.]azurecr[.]io[/]giantswarm[/]agentgateway-upstream[/]agentgateway$/',
        '/^gsoci[.]azurecr[.]io[/]giantswarm[/]agentgateway-upstream[/]controller$/',
      ],
      versioning: 'semver',
      groupName: 'agentgateway line',
      allowedVersions: '>=2.0.0 <3.0.0',
    },
  ],
}
