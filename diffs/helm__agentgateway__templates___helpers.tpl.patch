diff --git a/vendor/agentgateway/templates/_helpers.tpl b/helm/agentgateway/templates/_helpers.tpl
index c8d69aa..37a99a1 100644
--- a/vendor/agentgateway/templates/_helpers.tpl
+++ b/helm/agentgateway/templates/_helpers.tpl
@@ -27,7 +27,8 @@ If release name contains chart name it will be used as a full name.
 Create chart name and version as used by the chart label.
 */}}
 {{- define "agentgateway.chart" -}}
-{{- printf "%s-%s" .Chart.Name .Chart.Version | replace "+" "_" | trunc 63 | trimSuffix "-" }}
+{{- $chart := printf "%s-%s" .Chart.Name .Chart.Version | replace "+" "_" | trunc 63 }}
